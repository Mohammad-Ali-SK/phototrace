# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development            # development | production  (tests set "test" themselves)
SECRET_KEY=                    # REQUIRED, 32+ random chars: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+psycopg://phototrace:phototrace@localhost:5432/phototrace
CORS_ORIGINS=http://localhost:5173   # comma-separated exact frontend origins
COOKIE_SECURE=false            # must be true in production (HTTPS)
COOKIE_SAMESITE=lax            # use "none" (with COOKIE_SECURE=true) only if frontend and API are on different sites
SESSION_TTL_SECONDS=604800
OTP_TTL_SECONDS=600
RESEND_COOLDOWN_SECONDS=60
RATE_LIMIT_IP_PER_MIN=20
UPLOAD_DIR=uploads
# Email: configure Resend OR SMTP
RESEND_API_KEY=
EMAIL_FROM=PhotoTrace AI <login@your-verified-domain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=            # E.164, e.g. +15551234567

# Search Integrations (Optional; falls back to clearly labeled Demo provider if unconfigured)
# Provider selection: auto | google | bing | serpapi | demo
SEARCH_PROVIDER=auto

# Option A: Google Custom Search API (Name Search) & Google Cloud Vision (Reverse Image Search)
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_CX=               # Programmable Search Engine ID configured for public social sites
GOOGLE_VISION_API_KEY=          # API key with Cloud Vision API enabled (for reverse image web detection)

# Option B: Microsoft Azure Bing Web Search API
BING_SEARCH_API_KEY=

# Option C: SerpApi (Google search engine proxy)
SERPAPI_API_KEY=

